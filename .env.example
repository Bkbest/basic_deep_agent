TAVILY_API_KEY=<key>
SANDBOX_URL=<url>
# Dice job-search MCP server (Streamable HTTP, public read-only tools).
# Override only if Dice moves the endpoint; the default is the official URL.
DICE_MCP_URL=https://mcp.dice.com/mcp
# career-ops MCP server (LAN address by default; point this at wherever the
# server actually runs -- a localhost address will not resolve in production).
CAREER_OPS_MCP_URL=http://192.168.68.111:8765/mcp
POSTGRES_CONNECTION_STRING=postgresql://username:password@host:port/database

# ---------------------------------------------------------------------------
# LangSmith tracing
#
# LANGSMITH_AGENT_ID + LANGSMITH_AGENT_ENVIRONMENT address traces to an agent
# environment (beta). Do NOT also set LANGSMITH_PROJECT: langsmith raises
# EnvAddressError when an address and a project are both configured, and the
# run is left untraced.
#
# LANGSMITH_AGENT_ENVIRONMENT must be one of:
#   local | development | staging | production
# LANGSMITH_AGENT_ID must be a lowercase DNS label (start with a letter,
# end with a letter or digit, max 63 chars) -- e.g. agent-portal.
# LANGSMITH_API_KEY blank = tracing is off.
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<lsv2_pt_...>
LANGSMITH_AGENT_ID=agent-portal
LANGSMITH_AGENT_ENVIRONMENT=local
